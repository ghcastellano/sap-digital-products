    { "permission": "ASSIGN_ISSUES",            "holders": [{ "type": "projectRole", "parameter": "dp_pm_per_vs" }, { "type": "projectRole", "parameter": "dp_squad_lead" }, { "type": "projectRole", "parameter": "dp_admin" }] },

    { "permission": "ASSIGNABLE_USER",          "holders": [{ "type": "projectRole", "parameter": "dp_pm_per_vs" }, { "type": "projectRole", "parameter": "dp_architect" }, { "type": "projectRole", "parameter": "dp_squad_lead" }, { "type": "projectRole", "parameter": "dp_admin" }] },

